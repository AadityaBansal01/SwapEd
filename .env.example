# ============================================================================
# SwapEd — Environment Variables Configuration Example
# Copy this file to .env and customize for your local environment
# ============================================================================

# Server Port
PORT=8080
APP_BASE_URL=http://localhost:8080

# MySQL Database Connection (swap_ed_db)
DB_URL=jdbc:mysql://localhost:3306/swap_ed_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_root_password

# Allowed University Email Domain
ALLOWED_EMAIL_DOMAIN=thapar.edu

# SMTP Email Configuration (JavaMailSender)
# Required for sending live verification and password-reset emails via SMTP.
# For Gmail, generate a 16-character App Password under Google Account -> Security -> 2-Step Verification -> App Passwords.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_char_app_password
MAIL_FROM=noreply@swaped.thapar.edu

# File Uploads Directory
UPLOAD_DIR=uploads
